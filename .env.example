# AI provider: "mock" | "jev"
# With no key, the server stays in DEMO MODE / MOCK JEV even if AI_PROVIDER=jev.
AI_PROVIDER=mock

# Jev through OpenRouter Decisions API (server-side only).
# Docs: https://openrouter.ai/docs/guides/community/jev
# Endpoint: POST https://openrouter.ai/api/alpha/decisions
# Model: typesafe/jev-1.13
# Do not prefix this key with NEXT_PUBLIC_. It must not reach the browser.
OPENROUTER_API_KEY=
JEV_MODEL=typesafe/jev-1.13

# Optional Flight Analyst LLM (server-side only). This is a chat model, not Jev.
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
