# AI provider: "mock" | "jev"
# With no key, the server stays in DEMO MODE / MOCK JEV even if AI_PROVIDER=jev.
AI_PROVIDER=mock

# Which pilot the lab starts on: "jev" | "openai" | "mock" | "laya".
# The game, scheduler, timeout, and fallback stay the same either way.
# Switching in the UI does not require a restart. An unconfigured choice stays on mock.
DECISION_PROVIDER=jev

# Jev through OpenRouter Decisions API (server-side only).
# Docs: https://openrouter.ai/docs/guides/community/jev
# Endpoint: POST https://openrouter.ai/api/alpha/decisions
# Model: typesafe/jev-1.13
# Do not prefix this key with NEXT_PUBLIC_. It must not reach the browser.
OPENROUTER_API_KEY=
JEV_MODEL=typesafe/jev-1.13

# GPT tactical pilot (server-side only). The browser calls /api/openai/decision.
# gpt-4-mini is not a current model id. gpt-4.1-mini is the current low-latency
# mini with structured outputs (Responses API). Verified price 2026-10-01:
# $0.40 / 1M input tokens, $0.10 / 1M cached input, $1.60 / 1M output tokens.
# Do not prefix this key with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Local Laya GPU sidecar (server-side only). The browser calls /api/laya/decision.
# Start with: laya-mcp serve --host 127.0.0.1 --port 8000 --model typed-decisions --device cuda
# Or set LAYA_BASE_URL to a full ask URL (e.g. http://127.0.0.1:8787/v1/systemone).
LAYA_HOST=127.0.0.1
LAYA_PORT=8000
# LAYA_BASE_URL=http://127.0.0.1:8000

# Optional Flight Analyst LLM (server-side only). This is a chat model, not Jev.
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
